{
  "name": "@strata/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --config vite.demo.config.ts",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "fixtures": "cargo run -p strata-layout --example export_fixtures --release -- src/lib/layout/__fixtures__",
    "fixtures:large": "cargo run -p strata-layout --example export_fixtures --release -- src/dev/__fixtures__/large --large"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
